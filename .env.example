# Only API key required. Create one at https://console.groq.com/keys
GROQ_API_KEY=
# Both models support Groq's built-in browser_search. No separate search key.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
# Optional. Browser timezone takes precedence for each request.
APP_TIMEZONE=Asia/Kolkata
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# Entire turn deadline, including history planning and web research.
TURN_TIMEOUT_MS=180000
